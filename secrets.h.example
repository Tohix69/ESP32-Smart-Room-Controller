#pragma once

// Optional first-boot Wi-Fi credentials. The controller also supports
// configuring Wi-Fi through its fallback access point and web portal.
#define WIFI_SSID "YOUR_WIFI_NAME"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// Static IP is used only when connecting to the configured WIFI_SSID.
// Set WIFI_USE_STATIC_IP to 0 to use DHCP everywhere.
#define WIFI_USE_STATIC_IP true
#define LOCAL_IP       192, 168, 10, 150
#define GATEWAY_IP     192, 168, 10, 1
#define SUBNET_MASK    255, 255, 255, 0
#define PRIMARY_DNS    8, 8, 8, 8
#define SECONDARY_DNS  1, 1, 1, 1

// Fallback setup access point. Change the password before deployment.
#define AP_SSID "Lumino-Room-Setup"
#define AP_PASSWORD "CHANGE_THIS_AP_PASSWORD"

#define WIFI_RETRY_INTERVAL 15000
#define AP_FALLBACK_DELAY 15000
